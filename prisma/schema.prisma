model VolunteerAssignment {
  id                 String              @id @default(cuid())
  assignmentNumber   String              @unique // Auto: IMF-ASN-YYYY-XXXXX
  title              String
  description        String              @db.Text
  
  volunteerId        String
  volunteer          VolunteerProfile    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  
  location           String
  programOrProject   String?
  requiredSkills     String[]
  
  startDate          DateTime
  endDate            DateTime?
  status             AssignmentStatus    @default(ASSIGNED)
  
  coordinatorName    String?
  coordinatorContact String?
  notes              String?
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  hoursLogs          VolunteerHoursLog[]

  @@index([assignmentNumber])
  @@index([volunteerId])
  @@index([status])
}

model VolunteerHoursLog {
  id               String               @id @default(cuid())
  volunteerId      String
  volunteer        VolunteerProfile     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  assignmentId     String?
  assignment       VolunteerAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  
  date             DateTime             @default(now())
  hoursLogged      Decimal              @db.Decimal(6, 2)
  tasksCompleted   String               @db.Text
  supervisorRating Int                  @default(5)
  supervisorNotes  String?
  
