// ============================================================================
// 9. UNIFIED OFFICIAL CERTIFICATES & TAMPER-PROOF RECOGNITION
// ============================================================================

model OfficialCertificate {
  id                String            @id @default(cuid())
  certificateNumber String            @unique // Auto: IMF-CERT-YYYY-XXXXX
  certificateType   CertificateType
  
  recipientName     String
  recipientEmail    String
  
  memberId          String?
  member            MemberProfile?    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  volunteerId       String?
  volunteer         VolunteerProfile? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  
  title             String
  description       String            @db.Text
  
  issuedAt          DateTime          @default(now())
  expiresAt         DateTime?
  
  signatureHash     String            @unique
  qrVerificationUrl String
  pdfUrl            String?
  
  signatoryName     String            @default("Central Governance Board")
  signatoryTitle    String            @default("Executive Director & Trustee")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([certificateNumber])
  @@index([certificateType])
  @@index([recipientEmail])
  @@index([signatureHash])
}

// ============================================================================
// 10. PROJECT LIFECYCLE & MONITORING & EVALUATION (M&E)
// ============================================================================

model Project {
  id                        String              @id @default(cuid())
  organizationId            String              @default("ORG_IMF_HQ")
  projectNumber             String              @unique // Auto: IMF-PRJ-YYYY-XXXXX
  slug                      String              @unique
  title                     String
  description               String              @db.Text
  category                  ProjectCategory     @default(EMERGENCY_DISASTER_RELIEF)
  stage                     ProjectStage        @default(IDEA)
  
  locationCountry           String              @default("India")
  locationState             String?
  locationDistrict          String?
  
  targetBeneficiariesCount  Int                 @default(0)
  actualBeneficiariesCount  Int                 @default(0)
  
  allocatedBudgetINR        Decimal             @default(0.0) @db.Decimal(14, 2)
  disbursedAmountINR        Decimal             @default(0.0) @db.Decimal(14, 2)
  
  startDate                 DateTime?
  targetCompletionDate      DateTime?
  actualCompletionDate      DateTime?
  
  projectManagerUserId      String?
  projectManager            User?               @relation(fields: [projectManagerUserId], references: [id], onDelete: SetNull)
  
  isPublicFeatured          Boolean             @default(false)
  closureReportSummary      String?             @db.Text
  closureAuditedAt          DateTime?
  
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  milestones                ProjectMilestone[]
  metrics                   ProjectMetric[]
  fieldVisits               FieldVisit[]
  assistanceRecords         BeneficiaryAssistance[]
  beneficiaries             BeneficiaryProjectLink[]
  grants                    GrantAndCsrFunding[]
  expenses                  ExpenseRecord[]
  budgetLines               BudgetLine[]

  @@index([projectNumber])
  @@index([slug])
  @@index([stage])
  @@index([category])
}

model ProjectMilestone {
  id                   String       @id @default(cuid())
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title                String
  description          String       @db.Text
  targetDate           DateTime
  completionDate       DateTime?
  budgetAllocationINR  Decimal      @default(0.0) @db.Decimal(14, 2)
  isCompleted          Boolean      @default(false)
  verificationNotes    String?      @db.Text
  
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId])
  @@index([targetDate])
  @@index([isCompleted])
}

model ProjectMetric {
  id                   String       @id @default(cuid())
  projectId            String
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  indicatorName        String
  unitOfMeasure        String       // e.g. "Families", "Water Liters", "Students"
  targetValue          Decimal      @db.Decimal(12, 2)
  currentValue         Decimal      @default(0.0) @db.Decimal(12, 2)
  lastEvaluatedAt      DateTime     @default(now())
  evaluationNotes      String?      @db.Text

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([projectId])
}

// ============================================================================
// 11. SECURE BENEFICIARY REGISTRY & ENCRYPTED PII VAULT
// ============================================================================

model BeneficiaryProfile {
  id                      String                        @id @default(cuid())
  organizationId          String                        @default("ORG_IMF_HQ")
  beneficiaryNumber       String                        @unique // Auto: IMF-BEN-YYYY-XXXXX
  
  fullName                String
  gender                  String                        // MALE, FEMALE, OTHER
  dateOfBirth             DateTime?
  phone                   String?
  city                    String
  district                String?
  state                   String?
  country                 String                        @default("India")
  addressLine             String?
  
  category                BeneficiaryCategory           @default(GENERAL_DISTRESS)
  vulnerabilityTier       VulnerabilityTier             @default(MODERATE)
  vulnerabilityScore      Int                           @default(50) // 1 to 100 Index
  
  verificationStatus      BeneficiaryVerificationStatus @default(PENDING_VERIFICATION)
  verifiedByUserId        String?
  verifiedAt              DateTime?
  
  // AES-256-GCM Encrypted Sensitive PII Vault
  encryptedNationalId     String?                       @db.Text
  nationalIdMasked        String?
  encryptedRationCard     String?                       @db.Text
  rationCardMasked        String?
  encryptedBankAccount    String?                       @db.Text
  bankAccountMasked       String?
  encryptedIfscCode       String?                       @db.Text
  
  // Household & Socioeconomic Need Profile
  householdMemberCount    Int                           @default(1)
  monthlyIncomeINR        Decimal                       @default(0.0) @db.Decimal(12, 2)
  primaryNeedSummary      String                        @db.Text
  estimatedAidRequiredINR Decimal                       @default(0.0) @db.Decimal(14, 2)
  
  notes                   String?                       @db.Text
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  familyMembers           BeneficiaryFamilyMember[]
  documents               BeneficiaryDocument[]
  assistanceRecords       BeneficiaryAssistance[]
  followUps               BeneficiaryFollowUp[]
  fieldVisits             FieldVisit[]
  projects                BeneficiaryProjectLink[]

  @@index([beneficiaryNumber])
  @@index([category])
  @@index([vulnerabilityTier])
  @@index([verificationStatus])
  @@index([city])
}

model BeneficiaryProjectLink {
  id             String             @id @default(cuid())
  beneficiaryId  String
  beneficiary    BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enrolledAt     DateTime           @default(now())

  @@unique([beneficiaryId, projectId])
  @@index([beneficiaryId])
  @@index([projectId])
}

model BeneficiaryFamilyMember {
  id             String             @id @default(cuid())
  beneficiaryId  String
  beneficiary    BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  fullName       String
  relation       String             // e.g. "Spouse", "Son", "Daughter", "Mother"
  age            Int?
  gender         String?
  occupation     String?
  healthStatus   String?            // "Healthy", "Chronic Illness", "Disabled"
  isDependent    Boolean            @default(true)

  createdAt      DateTime           @default(now())

  @@index([beneficiaryId])
}

model BeneficiaryDocument {
  id               String             @id @default(cuid())
  beneficiaryId    String
  beneficiary      BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  title            String
  documentType     String             // AADHAAR, RATION_CARD, MEDICAL_REPORT, INCOME_CERT
  encryptedFileUrl String             @db.Text
  fileMimeType     String?
  isVerified       Boolean            @default(false)
  verifiedByUserId String?
  verifiedAt       DateTime?
  
  createdAt        DateTime           @default(now())

  @@index([beneficiaryId])
}

model BeneficiaryAssistance {
  id                 String             @id @default(cuid())
  assistanceNumber   String             @unique // Auto: IMF-AID-YYYY-XXXXX
  beneficiaryId      String
  beneficiary        BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  projectId          String?
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  assistanceType     AssistanceType     @default(DIRECT_BANK_TRANSFER)
  amountINR          Decimal            @default(0.0) @db.Decimal(14, 2)
  itemDescription    String             @db.Text
  
  disbursementDate   DateTime           @default(now())
  disbursedByUserId  String?
  paymentReference   String?
  receiptReference   String?
  status             String             @default("DISBURSED")
  notes              String?            @db.Text
  
  createdAt          DateTime           @default(now())

  @@index([assistanceNumber])
  @@index([beneficiaryId])
  @@index([projectId])
  @@index([assistanceType])
}

model BeneficiaryFollowUp {
  id                   String             @id @default(cuid())
  beneficiaryId        String
  beneficiary          BeneficiaryProfile @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  
  followUpDate         DateTime           @default(now())
  officerUserId        String?
  findingsNotes        String             @db.Text
  socioeconomicOutcome String             @db.Text // "Income improved", "Health stabilized", "Children back in school"
  nextFollowUpDate     DateTime?
  
  createdAt            DateTime           @default(now())

  @@index([beneficiaryId])
  @@index([followUpDate])
}

// ============================================================================
// 12. FIELD OPERATIONS & OFFLINE-SYNC SURVEYS
// ============================================================================

model FieldVisit {
  id                        String                @id @default(cuid())
  visitNumber               String                @unique // Auto: IMF-VIS-YYYY-XXXXX
  
  projectId                 String?
  project                   Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  beneficiaryId             String?
  beneficiary               BeneficiaryProfile?   @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  
  officerOrVolunteerUserId  String
  scheduledDate             DateTime              @default(now())
  completedDate             DateTime?
  status                    FieldVisitStatus      @default(SCHEDULED)
  
  gpsLatitude               Decimal?              @db.Decimal(10, 7)
  gpsLongitude              Decimal?              @db.Decimal(10, 7)
  locationAddress           String?
  
  geoPhotoUrls              String[]
  fieldObservations         String?               @db.Text
  needsVerificationSummary  String?               @db.Text
  
  supervisorReviewNotes     String?               @db.Text
  supervisorRating          Int?                  // 1 to 5 Stars
  reviewedByUserId          String?
  reviewedAt                DateTime?
  
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  surveyResponses           FieldSurveyResponse[]

  @@index([visitNumber])
  @@index([projectId])
  @@index([beneficiaryId])
  @@index([status])
  @@index([scheduledDate])
}

model FieldSurveyResponse {
  id                   String       @id @default(cuid())
  surveyNumber         String       @unique // Auto: IMF-SRV-YYYY-XXXXX
  
  fieldVisitId         String?
  fieldVisit           FieldVisit?  @relation(fields: [fieldVisitId], references: [id], onDelete: SetNull)
  
  beneficiaryId        String?
  surveyTemplateTitle  String
  answersJson          Json
  
  isOfflineCaptured    Boolean      @default(false)
  clientCapturedAt     DateTime?
  syncedAt             DateTime     @default(now())
  syncDeviceId         String?
  
  createdAt            DateTime     @default(now())

  @@index([surveyNumber])
  @@index([fieldVisitId])
  @@index([beneficiaryId])
  @@index([isOfflineCaptured])
}

// ============================================================================
// 13. EVENTS & REUSABLE EVENT OPERATING SYSTEM
// ============================================================================

model Event {
  id                      String                  @id @default(cuid())
  eventNumber             String                  @unique // Auto: IMF-EVT-YYYY-XXXXX
  title                   String
  slug                    String                  @unique
  summary                 String                  @db.Text
  description             String                  @db.Text
  
  eventType               EventType               @default(IN_PERSON)
  category                EventCategory           @default(COMMUNITY_MAJLIS)
  status                  EventStatus             @default(DRAFT)
  
  startDate               DateTime
  endDate                 DateTime
  registrationDeadline    DateTime?
  
  // Capacity & Pricing
  capacityMax             Int                     @default(100)
  capacityReserved        Int                     @default(0)
  isFree                  Boolean                 @default(true)
  ticketFeeINR            Decimal                 @default(0.0) @db.Decimal(10, 2)
  allowWaitlist           Boolean                 @default(true)
  requiresApproval        Boolean                 @default(false)
  
  // Physical Venue Details
  venueName               String?
  venueAddress            String?
  venueCity               String?
  venueMapUrl             String?
  venueGpsLat             Decimal?                @db.Decimal(10, 7)
  venueGpsLng             Decimal?                @db.Decimal(10, 7)
  
  // Virtual / Hybrid Livestream Architecture
  isVirtual               Boolean                 @default(false)
  meetingPlatform         String?                 // ZOOM, YOUTUBE_LIVE, GOOGLE_MEET, CUSTOM_RTMP
  meetingJoinUrl          String?
  meetingStreamKeyMasked  String?
  meetingRecordingUrl     String?
  streamEmbedCode         String?                 @db.Text
  
  // Media Assets
  coverImageUrl           String?
  bannerImageUrl          String?
  galleryUrls             String[]
  
  // Organizer Info
  organizerName           String                  @default("Imam E Mahdi Foundation")
  organizerEmail          String                  @default("events@imf-ngo.org")
  organizerPhone          String?
  
  publishedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  speakers                EventSpeaker[]
  registrations           EventRegistration[]
  feedbackResponses       EventFeedback[]
  report                  EventReport?

  @@index([eventNumber])
  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([startDate])
}

model EventSpeaker {
  id                String       @id @default(cuid())
  eventId           String
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name              String
  titleRole         String
  organization      String?
  bio               String?      @db.Text
  photoUrl          String?
  topicTitle        String?
  presentationTime  String?
  displayOrder      Int          @default(0)
  
  createdAt         DateTime     @default(now())

  @@index([eventId])
}

model EventRegistration {
  id                    String                  @id @default(cuid())
  registrationNumber    String                  @unique // Auto: IMF-REG-YYYY-XXXXX
  
  eventId               String
  event                 Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId                String?
  fullName              String
  email                 String
  phone                 String?
  city                  String?
  organization          String?
  notes                 String?                 @db.Text
  
  registrationStatus    EventRegistrationStatus @default(REGISTERED)
  ticketType            TicketType              @default(STANDARD)
  
  // Cryptographic QR Pass
  passSignatureHash     String                  @unique
  qrVerificationUrl     String
  
  // Check-In & Gate Attendance
  isCheckedIn           Boolean                 @default(false)
  checkedInAt           DateTime?
  checkedInByUserId     String?
  attendanceMethod      AttendanceMethod?
  
  hasSubmittedFeedback  Boolean                 @default(false)
  
  registeredAt          DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  feedback              EventFeedback?

  @@index([registrationNumber])
  @@index([eventId])
  @@index([email])
  @@index([passSignatureHash])
  @@index([registrationStatus])
}

model EventFeedback {
  id                     String             @id @default(cuid())
  eventId                String
  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  registrationId         String?            @unique
  registration           EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  
  participantName        String?
  ratingOverall          Int                @default(5) // 1 to 5 Stars
  ratingContent          Int                @default(5) // 1 to 5 Stars
  ratingVenueOrPlatform  Int                @default(5) // 1 to 5 Stars
  comments               String?            @db.Text
  suggestions            String?            @db.Text
  isAnonymous            Boolean            @default(false)
  
  submittedAt            DateTime           @default(now())

  @@index([eventId])
}

model EventReport {
  id                         String             @id @default(cuid())
  eventId                    String             @unique
  event                      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  totalRegistered            Int                @default(0)
  totalAttended              Int                @default(0)
  totalVolunteersEngaged     Int                @default(0)
  attendanceRatePercent      Decimal            @default(0.0) @db.Decimal(5, 2)
  totalCostINR               Decimal            @default(0.0) @db.Decimal(14, 2)
  
  keyOutcomes                String             @db.Text
  shariaComplianceCertified  Boolean            @default(true)
  submittedByUserId          String?
  submittedAt                DateTime           @default(now())

  @@index([eventId])
}

// ============================================================================
// 14. HUMAN RESOURCE MANAGEMENT & RECRUITMENT (HRMS)
// ============================================================================

model Department {
  id                  String             @id @default(cuid())
  code                String             @unique // e.g. HR, FIN, OPS, MED, EDU, SHARIA
  name                String
  description         String?            @db.Text
  headOfDeptUserId    String?
  budgetAllocationINR Decimal            @default(0.0) @db.Decimal(14, 2)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  designations        Designation[]
  employees           EmployeeProfile[]
  jobPostings         JobPosting[]

  @@index([code])
}

model Designation {
  id                  String             @id @default(cuid())
  code                String             @unique // e.g. DIR_EXEC, MGR_FIN, FLD_COORD, DOC_GEN
  title               String
  departmentId        String
  department          Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  payBandGrade        String?            // Level 1 to 10
  description         String?            @db.Text
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  employees           EmployeeProfile[]
  jobPostings         JobPosting[]

  @@index([code])
  @@index([departmentId])
}

model EmployeeProfile {
  id                         String             @id @default(cuid())
  employeeNumber             String             @unique // Auto: IMF-EMP-YYYY-XXXXX
  userId                     String?            @unique
  user                       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName                   String
  email                      String             @unique
  phone                      String
  gender                     String?
  dateOfBirth                DateTime?
  bloodGroup                 String?

  departmentId               String
  department                 Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  
  designationId              String
  designation                Designation        @relation(fields: [designationId], references: [id], onDelete: Restrict)
  
  employmentType             EmploymentType     @default(FULL_TIME)
  status                     EmployeeStatus     @default(PROBATION)

  joiningDate                DateTime           @default(now())
  confirmationDate           DateTime?
  probationEndDate           DateTime?
  resignationDate            DateTime?
  lastWorkingDate            DateTime?

  reportingManagerId         String?
  reportingManager           EmployeeProfile?   @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates               EmployeeProfile[]  @relation("ManagerSubordinates")

  // AES-256-GCM Encrypted Sensitive PII Vault
  encryptedNationalId        String?            @db.Text
  encryptedTaxId             String?            @db.Text
  encryptedBankAccount       String?            @db.Text
  encryptedIfscCode          String?            @db.Text
  encryptedMonthlySalaryINR  String?            @db.Text

  // Masked Public Fields
  maskedNationalId           String?
  maskedBankAccount          String?
  payBandGrade               String?

  // Emergency Contact
  emergencyContactName       String?
  emergencyContactPhone      String?
  emergencyContactRelation   String?

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  documents                  EmployeeDocument[]
  attendanceRecords          EmployeeAttendance[]
  leaveRequests              EmployeeLeave[]
  appraisals                 EmployeeAppraisal[]
  exitRecord                 EmployeeExit?
  jobOffers                  JobOffer[]
  salaryStructure            SalaryStructure?
  payslips                   Payslip[]

  @@index([employeeNumber])
  @@index([email])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([employmentType])
}

model EmployeeDocument {
  id                   String             @id @default(cuid())
  employeeId           String
  employee             EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  documentType         String             // APPOINTMENT_LETTER, IDENTITY_PROOF, DEGREE_CERTIFICATE, NDA, TAX_FORM
  title                String
  fileUrl              String             @db.Text
  isVerified           Boolean            @default(false)
  verifiedAt           DateTime?
  verifiedByUserId     String?

  createdAt            DateTime           @default(now())

  @@index([employeeId])
}

model JobPosting {
  id                   String             @id @default(cuid())
  jobCode              String             @unique // Auto: IMF-JOB-YYYY-XXXXX
  title                String
  slug                 String             @unique
  
  departmentId         String
  department           Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  
  designationId        String
  designation          Designation        @relation(fields: [designationId], references: [id], onDelete: Restrict)

  employmentType       EmploymentType     @default(FULL_TIME)
  locationCity         String             @default("New Delhi")
  isRemoteAllowed      Boolean            @default(false)
  vacanciesCount       Int                @default(1)

  experienceMinYears   Int                @default(0)
  qualification        String?
  salaryRangeDisplay   String?            // e.g. "Competitive NGO Scale (Grade 4)"
  
  description          String             @db.Text
  requirements         String             @db.Text
  benefits             String?            @db.Text
  
  status               JobPostingStatus   @default(DRAFT)
  publishedAt          DateTime?
  closingDate          DateTime?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  applications         JobApplication[]

  @@index([jobCode])
  @@index([slug])
  @@index([status])
  @@index([departmentId])
}

model JobApplication {
  id                   String                @id @default(cuid())
  applicationNumber    String                @unique // Auto: IMF-APP-YYYY-XXXXX

  jobPostingId         String
  jobPosting           JobPosting            @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  fullName             String
  email                String
  phone                String
  city                 String?
  
  currentOrganization  String?
  currentDesignation   String?
  totalExperienceYears Decimal?              @db.Decimal(4, 1)
  
  resumeUrl            String                @db.Text
  coverLetter          String?               @db.Text
  portfolioUrl         String?

  status               JobApplicationStatus  @default(APPLIED)
  shortlistRating      Int?                  // 1 to 5
  reviewNotes          String?               @db.Text

  appliedAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  interviews           JobInterview[]
  offers               JobOffer[]

  @@index([applicationNumber])
  @@index([jobPostingId])
  @@index([email])
  @@index([status])
}

model JobInterview {
  id                         String                    @id @default(cuid())
  interviewNumber            String                    @unique // Auto: IMF-INT-YYYY-XXXXX

  applicationId              String
  application                JobApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  round                      InterviewRound            @default(HR_SCREENING)
  scheduledAt                DateTime
  interviewerNames           String[]
  
  evaluationScore            Int?                      // 1 to 5 Stars
  technicalCompetencyNotes   String?                   @db.Text
  culturalFitNotes           String?                   @db.Text
  recommendation             InterviewRecommendation?
  completedAt                DateTime?

  createdAt                  DateTime                  @default(now())

  @@index([interviewNumber])
  @@index([applicationId])
}

model JobOffer {
  id                   String             @id @default(cuid())
  offerNumber          String             @unique // Auto: IMF-OFF-YYYY-XXXXX

  applicationId        String
  application          JobApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  employeeProfileId    String?
  employeeProfile      EmployeeProfile?   @relation(fields: [employeeProfileId], references: [id], onDelete: SetNull)

  offeredDesignation   String
  offeredDepartment    String
  annualCTC_INR        Decimal            @db.Decimal(14, 2)
  monthlyGrossINR      Decimal            @db.Decimal(14, 2)
  
  joiningDate          DateTime
  offerExpiryDate      DateTime
  offerLetterUrl       String?            @db.Text
  
  status               JobOfferStatus     @default(DRAFT)
  acceptedAt           DateTime?
  declinedReason       String?            @db.Text

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([offerNumber])
  @@index([applicationId])
}

model EmployeeAttendance {
  id                 String             @id @default(cuid())
  employeeId         String
  employee           EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date               DateTime           @db.Date
  checkInTime        DateTime?
  checkOutTime       DateTime?
  totalHoursWorked   Decimal            @default(0.0) @db.Decimal(4, 2)
  status             AttendanceStatus   @default(PRESENT)
  remarks            String?
  ipAddress          String?

  createdAt          DateTime           @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model EmployeeLeave {
  id                   String               @id @default(cuid())
  leaveNumber          String               @unique // Auto: IMF-LEV-YYYY-XXXXX

  employeeId           String
  employee             EmployeeProfile      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType            LeaveType            @default(ANNUAL_CASUAL)
  startDate            DateTime             @db.Date
  endDate              DateTime             @db.Date
  totalDays            Decimal              @db.Decimal(4, 1)
  
  reason               String               @db.Text
  status               LeaveApprovalStatus  @default(PENDING)
  
  appliedAt            DateTime             @default(now())
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectionReason      String?              @db.Text

  @@index([leaveNumber])
  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model EmployeeAppraisal {
  id                               String             @id @default(cuid())
  reviewNumber                     String             @unique // Auto: IMF-REV-YYYY-XXXXX

  employeeId                       String
  employee                         EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reviewerUserId                   String
  reviewCycleYear                  Int                @default(2026)
  reviewPeriod                     String             // "ANNUAL_2026", "H1_2026"

  kpiAchievementScore              Int                @default(4) // 1 to 5
  valuesAndEthicsScore             Int                @default(5) // 1 to 5
  leadershipScore                  Int                @default(4) // 1 to 5
  overallRating                    PerformanceRating  @default(MEETS_EXPECTATIONS)

  keyStrengths                     String             @db.Text
  developmentPlan                  String             @db.Text
  recommendedPromotionOrIncrement  String?            @db.Text
  status                           String             @default("FINALIZED")

  submittedAt                      DateTime           @default(now())

  @@index([reviewNumber])
  @@index([employeeId])
  @@index([reviewCycleYear])
}

model EmployeeExit {
  id                              String               @id @default(cuid())
  exitNumber                      String               @unique // Auto: IMF-EXT-YYYY-XXXXX

  employeeId                      String               @unique
  employee                        EmployeeProfile      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  resignationNoticeDate           DateTime             @default(now())
  requestedRelievingDate          DateTime
  agreedLastWorkingDate           DateTime?
  
  exitReason                      String               @db.Text
  handoverNotes                   String?              @db.Text
  assetReturnCompleted            Boolean              @default(false)

  itClearanceStatus               ExitClearanceStatus  @default(PENDING)
  financeClearanceStatus          ExitClearanceStatus  @default(PENDING)
  hrClearanceStatus               ExitClearanceStatus  @default(PENDING)
  governanceClearanceStatus       ExitClearanceStatus  @default(PENDING)

  exitInterviewFeedback           String?              @db.Text
  eligibleForRehire               Boolean              @default(true)

  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt

  @@index([exitNumber])
  @@index([employeeId])
}

model HrStatutoryConfig {
  id                     String             @id @default(cuid())
  configKey              String             @unique // e.g. "DEFAULT_NOTICE_PERIOD_DAYS", "ANNUAL_LEAVE_QUOTA"
  configCategory         String             // "LABOR_POLICY", "TAX_DISCLAIMER", "STATUTORY_BENEFITS"
  settingName            String
  settingValueJson       Json
  disclaimerTag          String             @default("REQUIRES_PROFESSIONAL_VERIFICATION")
  verifiedByLegalAdvisor Boolean            @default(false)
  lastVerifiedAt         DateTime?
  notes                  String?            @db.Text

  updatedAt              DateTime           @updatedAt

  @@index([configKey])
  @@index([configCategory])
}

// ============================================================================
// 15. MODULAR PAYROLL, COMPENSATION & STATUTORY ENGINE
// ============================================================================

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  PENDING_APPROVAL
  APPROVED
  DISBURSED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum DisbursementMode {
  BANK_TRANSFER
  UPI_DIRECT
  NEFT_RTGS
  CHEQUE
  CASH_IMPREST
}

enum StatutoryRuleCategory {
  INCOME_TAX_TDS
  PROVIDENT_FUND
  EMPLOYEE_STATE_INSURANCE
  PROFESSIONAL_TAX
  CUSTOM_ALLOWANCE
  CUSTOM_DEDUCTION
}

model SalaryStructure {
  id                         String             @id @default(cuid())
  employeeId                 String             @unique
  employee                   EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Monthly Earnings Base Components
  baseSalaryMonthly          Decimal            @default(0.0) @db.Decimal(12, 2)
  housingAllowanceMonthly    Decimal            @default(0.0) @db.Decimal(12, 2) // HRA
  transportAllowanceMonthly  Decimal            @default(0.0) @db.Decimal(12, 2)
  medicalAllowanceMonthly    Decimal            @default(0.0) @db.Decimal(12, 2)
  specialAllowanceMonthly    Decimal            @default(0.0) @db.Decimal(12, 2)

  // Derived Gross & CTC
  grossMonthlySalary         Decimal            @default(0.0) @db.Decimal(12, 2)
  annualCTC                  Decimal            @default(0.0) @db.Decimal(14, 2)
  
  // Custom Dynamic Allowances & Deductions Scheme
  customComponents           Json?              // e.g. [{"name": "Field Hardship Allowance", "amount": 5000, "isTaxable": true}]
  
  payGrade                   String?            // "L1", "L2", "L3", "EXEC"
  currency                   String             @default("INR")
  effectiveFrom              DateTime           @default(now())
  isActive                   Boolean            @default(true)
  
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([employeeId])
  @@index([isActive])
}

model PayrollPeriod {
  id                         String               @id @default(cuid())
  periodCode                 String               @unique // e.g. "PAY-2026-09"
  year                       Int
  month                      Int                  // 1 to 12
  startDate                  DateTime             @db.Date
  endDate                    DateTime             @db.Date
  totalWorkingDays           Int                  @default(30)
  
  status                     PayrollPeriodStatus  @default(DRAFT)
  
  totalGrossAmountINR        Decimal              @default(0.0) @db.Decimal(14, 2)
  totalDeductionsINR         Decimal              @default(0.0) @db.Decimal(14, 2)
  totalNetAmountINR          Decimal              @default(0.0) @db.Decimal(14, 2)
  totalEmployeesCount        Int                  @default(0)

  // Multi-Level Approval
  approvedByUserId           String?
  approvedAt                 DateTime?
  approvalRemarks            String?              @db.Text

  // Disbursement
  disbursedByUserId          String?
  disbursedAt                DateTime?
  disbursementMode           DisbursementMode     @default(BANK_TRANSFER)
  disbursementReference      String?
  
  // Financial General Ledger Linkage
  voucherId                  String?              @unique
  voucher                    Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  payslips                   Payslip[]

  @@unique([year, month])
  @@index([periodCode])
  @@index([status])
}

model Payslip {
  id                         String             @id @default(cuid())
  payslipNumber              String             @unique // Auto: IMF-PSL-YYYYMM-XXXXX
  
  payrollPeriodId            String
  payrollPeriod              PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  employeeId                 String
  employee                   EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  status                     PayslipStatus      @default(DRAFT)

  // Attendance & Proration Metrics
  workingDaysInMonth         Int                @default(30)
  daysPresent                Decimal            @default(0.0) @db.Decimal(4, 1)
  paidLeaveDays              Decimal            @default(0.0) @db.Decimal(4, 1)
  unpaidLeaveDays            Decimal            @default(0.0) @db.Decimal(4, 1) // LOP
  payableDays                Decimal            @default(0.0) @db.Decimal(4, 1)

  // Earnings Breakdown
  basicPay                   Decimal            @default(0.0) @db.Decimal(12, 2)
  hraAllowance               Decimal            @default(0.0) @db.Decimal(12, 2)
  transportAllowance         Decimal            @default(0.0) @db.Decimal(12, 2)
  medicalAllowance           Decimal            @default(0.0) @db.Decimal(12, 2)
  specialAllowance           Decimal            @default(0.0) @db.Decimal(12, 2)
  performanceBonus           Decimal            @default(0.0) @db.Decimal(12, 2)
  overtimeOrArrears          Decimal            @default(0.0) @db.Decimal(12, 2)
  totalEarningsGross         Decimal            @default(0.0) @db.Decimal(12, 2)

  // Deductions Breakdown
  lossOfPayDeduction         Decimal            @default(0.0) @db.Decimal(12, 2)
  statutoryTaxTDS            Decimal            @default(0.0) @db.Decimal(12, 2)
  statutoryProvidentFund     Decimal            @default(0.0) @db.Decimal(12, 2)
  statutoryInsurance         Decimal            @default(0.0) @db.Decimal(12, 2)
  voluntaryDeductions        Decimal            @default(0.0) @db.Decimal(12, 2)
  totalDeductions            Decimal            @default(0.0) @db.Decimal(12, 2)

  // Net Pay
  netPayableINR              Decimal            @default(0.0) @db.Decimal(12, 2)

  // Employer Statutory Match (Informational)
  employerProvidentFund      Decimal            @default(0.0) @db.Decimal(12, 2)
  employerInsurance          Decimal            @default(0.0) @db.Decimal(12, 2)

  // Masked Snapshot of Payment Destination
  maskedBankSnapshot         String?
  maskedPanSnapshot          String?
  encryptedBankSnapshot      String?            @db.Text

  // Tamper-Proof Cryptographic Verification
  verificationHash           String             @unique // HMAC-SHA256 signature
  digitalQrUrl               String?
  payslipPdfUrl              String?

  // Disbursement
  disbursedVia               DisbursementMode?
  transactionReference       String?
  paidAt                     DateTime?

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([payslipNumber])
  @@index([payrollPeriodId])
  @@index([employeeId])
  @@index([status])
  @@index([verificationHash])
}

model PayrollStatutoryRuleConfig {
  id                         String                 @id @default(cuid())
  ruleCode                   String                 @unique // e.g. "TAX_BRACKET_STANDARD", "PF_STATUTORY_RATE"
  ruleName                   String
  ruleCategory               StatutoryRuleCategory  @default(INCOME_TAX_TDS)
  
  calculationType            String                 // "PERCENTAGE_OF_BASIC", "PERCENTAGE_OF_GROSS", "SLAB_TIERED", "FLAT_AMOUNT"
  ruleParamsJson             Json                   // rate, slabs, minimum exemption limits, statutory caps
  
  isEmployerContribution     Boolean                @default(false)
  isEnabled                  Boolean                @default(true)
  
  disclaimerNotice           String                 @default("REQUIRES_PROFESSIONAL_VERIFICATION")
  verifiedByLegalAdvisor     Boolean                @default(false)
  lastVerifiedAt             DateTime?
  notes                      String?                @db.Text
  
  effectiveFrom              DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([ruleCode])
  @@index([ruleCategory])
  @@index([isEnabled])
}

// ============================================================================
// 16. INSTITUTIONAL GRANTS, CSR, EXPENSES, BUDGETS, VENDORS & RECONCILIATION
// ============================================================================

enum GrantType {
  INSTITUTIONAL_GRANT
  CSR_CORPORATE
  GOVERNMENT_SUBSIDY
  FOUNDATION_TRUST
  BILATERAL_AID
  OTHER
}

enum GrantStatus {
  PROPOSED
  SANCTIONED
  ACTIVE
  FULLY_UTILIZED
  EXPIRED
  TERMINATED
}

enum VendorCategory {
  SUPPLIES_MATERIALS
  CONTRACTOR_SERVICES
  MEDICAL_LOGISTICS
  UTILITIES_RENT
  PROFESSIONAL_LEGAL_AUDIT
  IT_INFRASTRUCTURE
  OTHER
}

enum ExpenseCategory {
  PROJECT_EXECUTION
  ADMINISTRATIVE_OVERHEAD
  FIELD_LOGISTICS
  RELIEF_AID_DIRECT
  UTILITIES_RENT
  LEGAL_AND_AUDIT
  CAPITAL_EXPENDITURE
  MARKETING_COMMUNICATION
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
  REVISED
  CLOSED
}

enum ReconciliationStatus {
  PENDING
  RECONCILED
  DISCREPANCY_FLAGGED
}

enum ReconciliationItemType {
  UNCREDITED_DEPOSIT
  UNPRESENTED_CHEQUE
  BANK_CHARGE_UNRECORDED
  DIRECT_DEBIT
  INTEREST_CREDIT
  OTHER_ADJUSTMENT
}

model GrantAndCsrFunding {
  id                         String             @id @default(cuid())
  grantNumber                String             @unique // Auto: IMF-GRNT-YYYY-XXXXX
  fundingAgencyName          String
  agencyContactPerson        String?
  agencyEmail                String?
  agencyPhone                String?
  grantType                  GrantType          @default(INSTITUTIONAL_GRANT)
  status                     GrantStatus        @default(ACTIVE)

  sanctionedAmountINR        Decimal            @db.Decimal(14, 2)
  disbursedAmountINR         Decimal            @default(0.0) @db.Decimal(14, 2)
  utilizedAmountINR          Decimal            @default(0.0) @db.Decimal(14, 2)
  balanceAmountINR           Decimal            @default(0.0) @db.Decimal(14, 2)

  purpose                    String             @db.Text
  grantStartDate             DateTime           @db.Date
  grantEndDate               DateTime           @db.Date
  complianceTerms            String?            @db.Text
  utilizationNotes           String?            @db.Text

  projectId                  String?
  project                    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  voucherId                  String?
  voucher                    Voucher?           @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  createdById                String             @default("FINANCE_OFFICER")
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([grantNumber])
  @@index([grantType])
  @@index([status])
  @@index([projectId])
}

model Vendor {
  id                         String             @id @default(cuid())
  vendorCode                 String             @unique // Auto: VND-XXXXX
  legalName                  String
  tradeName                  String?
  category                   VendorCategory     @default(SUPPLIES_MATERIALS)
  contactPerson              String
  email                      String
  phone                      String
  address                    String?            @db.Text
  city                       String?
  state                      String?
  pinCode                    String?

  panTaxId                   String?
  gstNumber                  String?
  bankName                   String?
  bankAccountNumber          String?
  bankIfscCode               String?
  encryptedBankAccount       String?            @db.Text

  rating                     Int                @default(5) // 1 to 5
  isBlacklisted              Boolean            @default(false)
  verifiedByUserId           String?
  verifiedAt                 DateTime?

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  expenses                   ExpenseRecord[]

  @@index([vendorCode])
  @@index([category])
  @@index([email])
}

model ExpenseRecord {
  id                         String             @id @default(cuid())
  expenseNumber              String             @unique // Auto: EXP-YYYYMM-XXXXX
  title                      String
  category                   ExpenseCategory    @default(PROJECT_EXECUTION)
  amount                     Decimal            @db.Decimal(14, 2)

  paymentDate                DateTime           @default(now())
  paymentMethod              PaymentMethod      @default(BANK_TRANSFER_NEFT)
  paymentReference           String?            // UTR / Cheque / Transaction ID

  vendorId                   String?
  vendor                     Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  projectId                  String?
  project                    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  budgetLineId               String?
  budgetLine                 BudgetLine?        @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)

  voucherId                  String?
  voucher                    Voucher?           @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  invoiceUrl                 String?            @db.Text
  remarks                    String?            @db.Text
  status                     ExpenseStatus      @default(DRAFT)

  approvedByUserId           String?
  approvedAt                 DateTime?
  createdById                String             @default("FINANCE_OFFICER")

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([expenseNumber])
  @@index([category])
  @@index([status])
  @@index([vendorId])
  @@index([projectId])
  @@index([budgetLineId])
  @@index([paymentDate])
}

model AnnualBudget {
  id                         String             @id @default(cuid())
  budgetCode                 String             @unique // Auto: BDG-YYYY-FY
  fiscalYear                 Int                @default(2026)
  title                      String
  totalAllocatedINR          Decimal            @default(0.0) @db.Decimal(14, 2)
  totalSpentINR              Decimal            @default(0.0) @db.Decimal(14, 2)
  status                     BudgetStatus       @default(ACTIVE)

  approvedByUserId           String?
  approvedAt                 DateTime?
  notes                      String?            @db.Text

  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  lines                      BudgetLine[]

  @@unique([fiscalYear, budgetCode])
  @@index([budgetCode])
  @@index([fiscalYear])
  @@index([status])
}

model BudgetLine {
  id                         String             @id @default(cuid())
  budgetId                   String
  budget                     AnnualBudget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  lineCode                   String             // e.g. "BL-MED-01", "BL-EDU-02"
  category                   ExpenseCategory    @default(PROJECT_EXECUTION)
  title                      String
  allocatedAmountINR         Decimal            @db.Decimal(14, 2)
  spentAmountINR             Decimal            @default(0.0) @db.Decimal(14, 2)

  projectId                  String?
  project                    Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  accountHeadId              String?
  accountHead                AccountHead?       @relation(fields: [accountHeadId], references: [id], onDelete: SetNull)

  notes                      String?            @db.Text
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  expenses                   ExpenseRecord[]

  @@index([budgetId])
  @@index([lineCode])
  @@index([category])
  @@index([projectId])
}

model BankReconciliationStatement {
  id                         String                 @id @default(cuid())
  reconCode                  String                 @unique // Auto: BRS-YYYYMM-XXXXX
  
  bankAccountHeadId          String
  accountHead                AccountHead            @relation(fields: [bankAccountHeadId], references: [id], onDelete: Restrict)

  statementDate              DateTime               @db.Date
  statementClosingBalance    Decimal                @db.Decimal(14, 2)
  bookClosingBalance         Decimal                @db.Decimal(14, 2)

  uncreditedDeposits         Decimal                @default(0.0) @db.Decimal(14, 2)
  unpresentedCheques         Decimal                @default(0.0) @db.Decimal(14, 2)
  netAdjustments             Decimal                @default(0.0) @db.Decimal(14, 2)
  reconciledBalance          Decimal                @db.Decimal(14, 2)
  discrepancyAmount          Decimal                @default(0.0) @db.Decimal(14, 2)

  status                     ReconciliationStatus   @default(PENDING)
  verifiedByAuditorUserId    String?
  auditorSignOffNotes        String?                @db.Text
  verifiedAt                 DateTime?

  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  items                      ReconciliationItem[]

  @@index([reconCode])
  @@index([bankAccountHeadId])
  @@index([status])
  @@index([statementDate])
}

model ReconciliationItem {
  id                         String                 @id @default(cuid())
  statementId                String
  statement                  BankReconciliationStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  transactionDate            DateTime               @db.Date
  referenceNumber            String?
  description                String
  amount                     Decimal                @db.Decimal(14, 2)
  itemType                   ReconciliationItemType @default(UNCREDITED_DEPOSIT)

  isCleared                  Boolean                @default(false)
  clearedAt                  DateTime?

  voucherId                  String?
  voucher                    Voucher?               @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  createdAt                  DateTime               @default(now())

  @@index([statementId])
  @@index([itemType])
  @@index([isCleared])
}

model AccountingStatutoryConfig {
  id                         String             @id @default(cuid())
  configKey                  String             @unique // e.g. "CHARITABLE_UTILIZATION_MIN_PCT", "CORPUS_CAPITALIZATION_RULE"
  configCategory             String             // "NON_PROFIT_COMPLIANCE", "TAX_EXEMPTION_ASSUMPTIONS", "TDS_VENDOR_RATES"
  ruleName                   String
  ruleParamsJson             Json
  disclaimerTag              String             @default("REQUIRES_PROFESSIONAL_VERIFICATION")
  verifiedByAuditor          Boolean            @default(false)
  lastVerifiedAt             DateTime?
  notes                      String?            @db.Text

  updatedAt                  DateTime           @updatedAt

  @@index([configKey])
  @@index([configCategory])
}

// ============================================================================
// 17. CENTRALIZED DOCUMENT ENGINE, QR AGENT & COMMUNICATION ENGINE
// ============================================================================

enum DocumentType {
  DONATION_RECEIPT
  MEMBER_ID
  EMPLOYEE_ID
  MEMBERSHIP_CERTIFICATE
  VOLUNTEER_CERTIFICATE
  APPRECIATION_CERTIFICATE
  APPOINTMENT_LETTER
  OFFER_LETTER
  PAYSLIP
  DONATION_STATEMENT
  PROJECT_REPORT
  IMPACT_REPORT
}

enum DocumentStatus {
  VALID
  REVOKED
  EXPIRED
  PENDING_APPROVAL
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

model GeneratedDocument {
  id                   String           @id @default(cuid())
  documentNumber       String           @unique // Auto: IMF-DOC-YYYY-XXXXX or custom prefix
  documentType         DocumentType
  title                String
  templateVersion      String           @default("1.0.0")
  status               DocumentStatus   @default(VALID)
  
  recipientName        String
  recipientEmail       String?
  recipientPhone       String?
  
  metadataJson         Json             // All domain-specific parameters (amounts, dates, items)
  signatoriesJson      Json             // [{ name, title, role, signatureDate, sealUrl }]
  
  signatureHash        String           @unique // HMAC-SHA256 signature
  qrCodeSvg            String?          @db.Text // Embedded SVG QR code
  qrVerificationUrl    String           // Direct verification URL
  
  htmlContent          String?          @db.Text // Full rendered document HTML
  fileUrl              String?          @db.Text
  
  generatedAt          DateTime         @default(now())
  expiresAt            DateTime?
  revokedAt            DateTime?
  revokedReason        String?
  
  // Optional foreign keys for cross-linking
  donationId           String?
  memberProfileId      String?
  volunteerProfileId   String?
  employeeProfileId    String?
  payslipId            String?
  projectId            String?

  createdById          String           @default("SYSTEM")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([documentNumber])
  @@index([documentType])
  @@index([signatureHash])
  @@index([recipientEmail])
  @@index([status])
  @@index([generatedAt])
}

model CommunicationTemplate {
  id                   String                @id @default(cuid())
  templateKey          String                @unique // e.g. "DONATION_RECEIPT_ISSUED", "PAYSLIP_GENERATED"
  name                 String
  category             String                @default("GENERAL")
  description          String?
  
  subjectTemplate      String?
  bodyTemplate         String                @db.Text
  whatsappTemplateName String?
  smsTemplateId        String?               // DLT Template ID for India SMS
  
  allowedChannels      CommunicationChannel[]
  variablesJson        Json                  // Expected variable names & descriptions
  version              String                @default("1.0.0")
  isActive             Boolean               @default(true)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([templateKey])
  @@index([category])
}

model CommunicationLog {
  id                   String                @id @default(cuid())
  channel              CommunicationChannel
  templateKey          String
  recipientIdentifier  String                // Email address, Phone number, or UserId
  recipientName        String?
  subject              String?
  messageContent       String                @db.Text
  status               DeliveryStatus        @default(SENT)
  providerMessageId    String?
  errorDetails         String?               @db.Text
  metadataJson         Json?
  
  documentId           String?
  
  sentAt               DateTime              @default(now())
  deliveredAt          DateTime?
  readAt               DateTime?

  @@index([channel])
  @@index([templateKey])
  @@index([recipientIdentifier])
  @@index([status])
  @@index([sentAt])
}

model InAppNotification {
  id                   String           @id @default(cuid())
  userId               String?          // null = broadcast to all administrative staff
  title                String
  message              String           @db.Text
  category             String           @default("SYSTEM") // DONATION, BENEFICIARY, COMPLIANCE, HR, SYSTEM
  isRead               Boolean          @default(false)
  isUrgent             Boolean          @default(false)
  linkUrl              String?
  documentId           String?
  
  createdAt            DateTime         @default(now())
  readAt               DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([category])
  @@index([createdAt])
}

// ============================================================================
// 18. COMPLIANCE AGENT & STATUTORY DOCUMENT MANAGEMENT VAULT
// ============================================================================

enum ComplianceCategory {
  INCORPORATION_GOVERNANCE
  DIRECT_TAX_12A_80G
  INDIRECT_TAX_GST_PT
  FCRA_FOREIGN_CONTRIBUTION
  CSR_CORPORATE_GRANTS
  STATUTORY_AUDIT_ACCOUNTS
  ANNUAL_STATUTORY_FILINGS
  ORGANIZATIONAL_POLICIES
  LEGAL_AGREEMENTS_CONTRACTS
  LABOUR_EPF_ESIC
}

enum CompliancePeriodicity {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
  ONE_TIME
  EVENT_DRIVEN
}

enum ComplianceFilingStatus {
  PENDING
  IN_PROGRESS
  FILED_PENDING_ACK
  COMPLETED
  OVERDUE
  EXEMPTED
}

enum ProfessionalVerificationStatus {
  UNVERIFIED
  REQUIRES_PROFESSIONAL_VERIFICATION
  VERIFIED_BY_CHARTERED_ACCOUNTANT
  VERIFIED_BY_COMPANY_SECRETARY
  VERIFIED_BY_LEGAL_COUNSEL
  REJECTED_NEEDS_REVISION
}

model StatutoryDocument {
  id                         String                         @id @default(cuid())
  documentCode               String                         @unique // e.g. "DOC-INC-001", "DOC-80G-2026"
  category                   ComplianceCategory
  documentType               String                         // "MOA", "AOA", "SECTION_8_LICENSE", "PAN", "TAN", "FORM_10BD", etc.
  title                      String
  description                String?                        @db.Text
  
  registrationNumber         String?                        // e.g. 80G Unique Regn No, GSTIN, PAN
  issuingAuthority           String                         // "Ministry of Corporate Affairs", "Income Tax Department", "MHA"
  
  effectiveDate              DateTime?                      @db.Date
  expiryDate                 DateTime?                      @db.Date
  isPerpetual                Boolean                        @default(false)
  
  fileUrl                    String?                        @db.Text
  fileName                   String?
  fileSizeBytes              Int?
  mimeType                   String?
  
  // AES-256-GCM Encrypted payload for confidential items (e.g. banking mandates, tax credentials)
  isConfidential             Boolean                        @default(false)
  encryptedMetadata          String?                        @db.Text
  
  // Professional Verification Sign-Off
  verificationStatus         ProfessionalVerificationStatus @default(REQUIRES_PROFESSIONAL_VERIFICATION)
  verifiedByProfessionalName String?
  professionalRegnNumber     String?                        // ICAI / ICSI / Bar Council Membership No
  professionalFirmName       String?
  verificationNotes          String?                        @db.Text
  verifiedAt                 DateTime?
  
  disclaimerNotice           String                         @default("Administrative record tracking. Does not constitute government certification or legal advice. REQUIRES ORGANIZATIONAL / CA / CS / LEGAL VERIFICATION.")

  createdById                String                         @default("SYSTEM")
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  calendarEvents             ComplianceCalendarItem[]

  @@index([category])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([expiryDate])
}

model ComplianceCalendarItem {
  id                         String                         @id @default(cuid())
  itemCode                   String                         @unique // e.g. "CMP-2026-10BD", "CMP-2026-Q1-TDS"
  requirementName            String
  category                   ComplianceCategory
  periodicity                CompliancePeriodicity          @default(ANNUAL)
  statutoryAuthority         String                         // "Income Tax Dept", "MCA", "MHA", "GST Council"
  applicableActOrRule        String                         // e.g. "Section 80G(5)(vi) r.w. Rule 18AB", "Section 139(4A) IT Act"
  
  fiscalYear                 String                         // "2025-26"
  dueDate                    DateTime                       @db.Date
  extendedDueDate            DateTime?                      @db.Date
  filingDate                 DateTime?                      @db.Date
  
  responsiblePersonName      String
  responsiblePersonRole      String                         // "CFO / Head of Finance", "Company Secretary", "CA Firm"
  responsiblePersonEmail     String
  responsiblePersonPhone     String?
  
  status                     ComplianceFilingStatus         @default(PENDING)
  acknowledgementNumber      String?                        // e.g. IT Return Ack Number / MCA SRN
  
  // Linked Document in Vault
  statutoryDocumentId        String?
  statutoryDocument          StatutoryDocument?             @relation(fields: [statutoryDocumentId], references: [id], onDelete: SetNull)
  
  // Reminder Configuration
  reminderDaysBefore         Int[]                          @default([30, 15, 7, 1])
  lastReminderSentAt         DateTime?
  
  // Professional Verification
  verificationStatus         ProfessionalVerificationStatus @default(REQUIRES_PROFESSIONAL_VERIFICATION)
  verifiedByProfessionalName String?
  professionalRegnNumber     String?
  verificationNotes          String?                        @db.Text
  verifiedAt                 DateTime?
  
  disclaimerNotice           String                         @default("Administrative tracking tool. Software does not provide legal approval or tax advice. REQUIRES ORGANIZATIONAL / CA / CS / LEGAL VERIFICATION.")

  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  @@index([dueDate])
  @@index([status])
  @@index([category])
  @@index([fiscalYear])
  @@index([verificationStatus])
}

