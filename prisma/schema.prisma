// 19. AI AGENT & ENTERPRISE INTELLIGENCE SUITE (HITL GOVERNANCE)
// ============================================================================

enum AiTaskType {
  CONTENT_DRAFTING
  CAMPAIGN_WRITING
  BLOG_DRAFTING
  EMAIL_DRAFTING
  WHATSAPP_DRAFTING
  TRANSLATION
  SUMMARIZATION
  REPORT_DRAFTING
  IMPACT_REPORT_DRAFTING
  DATA_INSIGHTS
  DASHBOARD_EXPLANATION
  FAQ_GENERATION
  SEO_ASSISTANCE
}

enum AiSafetyDomain {
  GENERAL_PUBLIC
  LEGAL
  FINANCIAL
  COMPLIANCE
  REGULATORY
}

enum AiDraftStatus {
  DRAFT_PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

model AiDraftRecord {
  id                         String           @id @default(cuid())
  draftCode                  String           @unique // Auto: AID-YYYY-XXXXX
  taskType                   AiTaskType
  safetyDomain               AiSafetyDomain   @default(GENERAL_PUBLIC)
  title                      String
  
  promptSanitized            String           @db.Text
  generatedOutput            String           @db.Text
  editedOutput               String?          @db.Text
  status                     AiDraftStatus    @default(DRAFT_PENDING_REVIEW)
  
  // Pluggable Model Metadata
  providerName               String           @default("GEMINI")
  modelName                  String           @default("gemini-1.5-flash")
  tokensUsed                 Int              @default(0)
  latencyMs                  Int              @default(0)
  
  // Target Module Integration
  targetModule               String?          // e.g. "CMS", "CAMPAIGNS", "COMMUNICATION", "REPORTS"
  targetEntityId             String?
  
  // Human Review & Approval Sign-off (HITL)
  requiresHumanApproval      Boolean          @default(true)
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  approvalNotes              String?          @db.Text
  publishedAt                DateTime?
  
  createdById                String           @default("SYSTEM")
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@index([taskType])
  @@index([safetyDomain])
  @@index([status])
  @@index([createdAt])
}

model AiGenerationLog {
  id                         String           @id @default(cuid())
  taskType                   AiTaskType
  safetyDomain               AiSafetyDomain
  providerName               String
  modelName                  String
  
  promptSanitized            String           @db.Text
  responsePreview            String?          @db.Text
  
  tokensPrompt               Int              @default(0)
  tokensCompletion           Int              @default(0)
  latencyMs                  Int              @default(0)
  isSuccess                  Boolean          @default(true)
  errorMessage               String?          @db.Text
  
  createdById                String           @default("SYSTEM")
  createdAt                  DateTime         @default(now())

  @@index([taskType])
  @@index([providerName])
  @@index([createdAt])
}

// ============================================================================
// 20. GLOBAL ARCHITECTURE, MULTI-OFFICE & INTERNATIONAL COMPLIANCE
// ============================================================================

enum OfficeType {
  GLOBAL_HEADQUARTERS
  REGIONAL_CHAPTER
  NATIONAL_OFFICE
  FIELD_OUTPOST
  LIAISON_OFFICE
}

model OfficeLocation {
  id                    String      @id @default(cuid())
  officeCode            String      @unique // e.g. "IMF-HQ-DELHI", "IMF-UK-LONDON", "IMF-US-TEXAS"
  officeName            String
  officeType            OfficeType  @default(REGIONAL_CHAPTER)
  
  countryCode           String      // ISO-3166-1 alpha-2 (e.g. "IN", "GB", "US", "AE", "SA")
  stateProvince         String?
  city                  String
  postalCode            String?
  addressLine           String?     @db.Text
  
  defaultCurrency       String      @default("INR")
  defaultTimezone       String      @default("Asia/Kolkata")
  defaultLanguage       String      @default("en")
  
  contactEmail          String
  contactPhone          String?
  representativeName    String?
  
  taxRegistrationNumber String?     // Country-specific legal entity / charity / incorporation ID
  isActive              Boolean     @default(true)
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([countryCode])
  @@index([officeType])
  @@index([isActive])
}

model ExchangeRateRecord {
  id                    String      @id @default(cuid())
  baseCurrency          String      @default("INR") // Anchor currency
  targetCurrency        String      // e.g. "USD", "GBP", "EUR", "AED", "SAR", "CAD", "AUD"
  rate                  Decimal     @db.Decimal(18, 6) // e.g. 1 USD = 86.500000 INR
  source                String      @default("MANUAL_TREASURY") // "MANUAL_TREASURY" | "FOREX_FEED" | "CENTRAL_BANK"
  effectiveDate         DateTime    @default(now())
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([baseCurrency, targetCurrency])
  @@index([baseCurrency])
  @@index([targetCurrency])
}

model InternationalDonorProfile {
  id                    String      @id @default(cuid())
  donorNumber           String      @unique // e.g. "IMF-IDON-YYYY-XXXXX"
  userId                String?
  
  fullName              String
  email                 String
  phone                 String?
  
  countryCode           String      // ISO 2-letter (e.g. "GB", "US", "AE")
  preferredCurrency     String      @default("USD")
  preferredLanguage     String      @default("en")
  preferredTimezone     String?
  
  // Country-Specific Tax & Compliance Profile
  taxIdType             String?     // "PAN", "SSN", "EIN", "NINO", "NATIONAL_ID"
  taxIdMasked           String?
  giftAidConsentUK      Boolean     @default(false)
  giftAidConsentDate    DateTime?
  
  taxExemptionEligible  Boolean     @default(true)
  statutoryCategory     String?     // "RESIDENT", "NON_RESIDENT", "FOREIGN_NATIONAL", "CORPORATE"
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([countryCode])
  @@index([preferredCurrency])
  @@index([email])
}

model CountryComplianceSetting {
  id                         String      @id @default(cuid())
  countryCode                String      @unique // ISO 2-letter (e.g. "IN", "GB", "US", "AE")
  countryName                String
  
  defaultCurrency            String
  supportedCurrencies        String[]
  defaultLanguage            String
  supportedLanguages         String[]
  defaultTimezone            String
  
  // Formatting Configuration
  numberingSystem            String      @default("INTERNATIONAL_MILLION_BILLION") // "INDIAN_LAKH_CRORE" | "INTERNATIONAL_MILLION_BILLION"
  dateFormat                 String      @default("DD/MM/YYYY")
  
  // Tax Exemption Scheme
  taxSchemeName              String?     // "SECTION_80G", "GIFT_AID", "IRS_501C3", "ZAKAT_DEDUCTION"
  taxIdLabel                 String?     // "PAN Card Number", "National Insurance No", "SSN / EIN"
  taxIdRegex                 String?
  isTaxReceiptEligible       Boolean     @default(false)
  
  // Payment Gateway Routing
  preferredPaymentProvider   String      @default("STRIPE") // "RAZORPAY", "STRIPE", "PAYPAL", "CASHFREE"
  
  statutoryDisclaimer        String?     @db.Text
  isDonationActive           Boolean     @default(true)
  
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([countryCode])
  @@index([isDonationActive])
}

