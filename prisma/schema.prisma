// ============================================================================
// 1. IDENTITY & ACCESS MANAGEMENT (IAM)
// ============================================================================

model User {
  id                String      @id @default(cuid())
  organizationId    String      @default("ORG_IMF_HQ")
  email             String      @unique
  emailVerified     DateTime?
  passwordHash      String?
  name              String
  phone             String?     @unique
  avatarUrl         String?
  status            UserStatus  @default(ACTIVE)
  twoFactorEnabled  Boolean     @default(false)
  twoFactorSecret   String?     // Base32 TOTP Secret
  preferredLanguage String      @default("en") // en, hi, ur, ar
  countryCode       String      @default("IND")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  roles             UserRole[]
  sessions          Session[]
  accounts          Account[]
  auditLogs         AuditLog[]
  uploadedFiles     StorageObject[]

  // Profiles
  donorProfile      DonorProfile?
  memberProfile     MemberProfile?
  volunteerProfile  VolunteerProfile?
  employeeProfile   EmployeeProfile?
  managedProjects   Project[]

  // CMS authored records
  authoredPages     CmsPage[]   @relation("PageAuthor")
  authoredArticles  CmsArticle[] @relation("ArticleAuthor")

  @@index([email])
  @@index([phone])
  @@index([organizationId, status])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleType         @unique
  displayName String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  description String
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// 2. AUDIT TRAIL, SETTINGS & STORAGE
// ============================================================================

model AuditLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  previousData Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  rollingHash  String?
  createdAt    DateTime  @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String   @default("ORG_IMF_HQ")
  key            String   @unique
  value          String   @db.Text
  category       String
  isSecret       Boolean  @default(false)
  description    String?
  updatedAt      DateTime @updatedAt

  @@index([key])
}

model StorageObject {
  id           String        @id @default(cuid())
  fileKey      String        @unique
  fileName     String
  fileSize     Int
  mimeType     String
  bucket       StorageBucket
  isEncrypted  Boolean       @default(false)
  encryptionIv String?
  authTag      String?
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  @@index([bucket])
  @@index([uploadedById])
}

// ============================================================================
// 3. CMS & DYNAMIC CONTENT WORKFLOW ENGINE
// ============================================================================

model CmsPage {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  titleUrdu      String?
  titleHindi     String?
  titleArabic    String?
  subtitle       String?
  contentHtml    String                @db.Text
  contentJson    Json?
  status         ContentWorkflowStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  authorId       String?
  author         User?                 @relation("PageAuthor", fields: [authorId], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([slug])
  @@index([status])
}

model CmsProgram {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  category       String
  summary        String
  description    String                @db.Text
  iconName       String                @default("Heart")
  coverImageUrl  String
  beneficiariesCount Int               @default(0)
  status         ContentWorkflowStatus @default(DRAFT)
  orderIndex     Int                   @default(0)
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([slug])
  @@index([status])
}

model CmsArticle {
  id             String                @id @default(cuid())
  slug           String                @unique
  type           ArticleType           @default(BLOG)
  title          String
  summary        String
  content        String                @db.Text
  coverImageUrl  String
  tags           String[]
  authorName     String                @default("Editorial Team")
  authorId       String?
  author         User?                 @relation("ArticleAuthor", fields: [authorId], references: [id])
  readingMinutes Int                   @default(4)
  viewCount      Int                   @default(0)
  status         ContentWorkflowStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([slug])
  @@index([type, status])
}

model CmsStory {
  id               String                @id @default(cuid())
  slug             String                @unique
  title            String
  beneficiaryName  String
  location         String
  category         String
  summary          String
  quote            String
  storyFull        String                @db.Text
  coverImageUrl    String
  beforeAfterImage String?
  status           ContentWorkflowStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([slug])
  @@index([status])
}

model CmsMediaAsset {
  id          String                @id @default(cuid())
  type        MediaType             @default(PHOTO)
  title       String
  category    String
  mediaUrl    String
  thumbnailUrl String?
  eventDate   DateTime?
  status      ContentWorkflowStatus @default(PUBLISHED)
  orderIndex  Int                   @default(0)
  createdAt   DateTime              @default(now())

  @@index([type, status])
}

model CmsFaq {
  id          String                @id @default(cuid())
  question    String
  answer      String                @db.Text
  category    FaqCategory           @default(GENERAL)
  orderIndex  Int                   @default(0)
  status      ContentWorkflowStatus @default(PUBLISHED)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([category, status])
}

model CmsMenuItem {
  id          String    @id @default(cuid())
  location    String
  title       String
  href        String
  orderIndex  Int       @default(0)
  parentId    String?
  isActive    Boolean   @default(true)

  @@index([location, orderIndex])
}

model PublicInquiry {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String    @db.Text
  category    String    @default("GENERAL")
  status      String    @default("NEW")
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

model VolunteerApplication {
  id           String    @id @default(cuid())
  fullName     String
  email        String
  phone        String
  city         String
  state        String?
  skills       String[]
  availability String
  notes        String?   @db.Text
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())

  @@index([status])
}

// ============================================================================
// 4. CONFIGURABLE DONATION CATEGORIES & CAMPAIGNS
// ============================================================================

model DonationCategory {
  id                   String           @id @default(cuid())
  organizationId       String           @default("ORG_IMF_HQ")
  slug                 String           @unique
  name                 String
  fundType             FundType         @default(GENERAL_SADAQAH)
  description          String
  iconName             String           @default("Heart")
  
  // Strict Configurable Compliance Attributes
  is80GEligible        Boolean          @default(false)
  is12ABEligible       Boolean          @default(false)
  isFcraEligible       Boolean          @default(false)
  isZakatEligible      Boolean          @default(false)
  isKhumsEligible      Boolean          @default(false)
  taxDeductionPercent  Int              @default(0) // 0, 50, or 100
  complianceStatus     ComplianceStatus @default(UNVERIFIED)
  complianceApprovedBy String?
  complianceApprovalDate DateTime?
  complianceNotes      String?          @db.Text
  
  // General Ledger Linkage
  chartOfAccountId     String?
  chartOfAccount       AccountHead?     @relation(fields: [chartOfAccountId], references: [id])
  
  orderIndex           Int              @default(0)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  donations            Donation[]
  campaigns            Campaign[]

  @@index([slug])
  @@index([fundType])
  @@index([complianceStatus])
  @@index([isActive])
}

model Campaign {
  id                   String            @id @default(cuid())
  organizationId       String            @default("ORG_IMF_HQ")
  slug                 String            @unique
  title                String
  titleUrdu            String?
  titleHindi           String?
  titleArabic          String?
  shortDescription     String
  fullDescription      String            @db.Text
  coverImageUrl        String
  galleryImages        String[]
  
  categoryId           String?
  category             DonationCategory? @relation(fields: [categoryId], references: [id])
  fundType             FundType          @default(GENERAL_SADAQAH)
  
  // Target & Collections
  currency             String            @default("INR")
  targetAmount         Decimal           @db.Decimal(14, 2)
  raisedAmount         Decimal           @default(0.0) @db.Decimal(14, 2)
  donorCount           Int               @default(0)
  
  // Flags & Visibility
  isFeatured           Boolean           @default(false)
  isEmergencyAppeal    Boolean           @default(false)
  
  // Strict Configurable Compliance Attributes
  is80GEligible        Boolean           @default(false)
  is12ABEligible       Boolean           @default(false)
  isFcraEligible       Boolean           @default(false)
  isZakatEligible      Boolean           @default(false)
  isKhumsEligible      Boolean           @default(false)
  taxDeductionPercent  Int               @default(0)
  complianceStatus     ComplianceStatus  @default(UNVERIFIED)
  complianceApprovedBy String?
  complianceApprovalDate DateTime?
  complianceNotes      String?           @db.Text
  
  startDate            DateTime          @default(now())
  endDate              DateTime?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  donations            Donation[]

  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([fundType])
  @@index([complianceStatus])
}

// ============================================================================
// 5. DONOR CRM, TRANSACTIONS & CRYPTOGRAPHIC RECEIPTS
// ============================================================================

model DonorProfile {
  id                  String             @id @default(cuid())
  userId              String?            @unique
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName            String
  email               String             @unique
  phone               String?
  panEncrypted        String?            // AES-256 encrypted PAN
  panMasked           String?            // e.g. "ABCDE****F"
  nationalIdEncrypted String?            // Encrypted Aadhaar/Passport
  isTaxExemptEligible Boolean            @default(false)
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String             @default("India")
  totalDonatedAmount  Decimal            @default(0.0) @db.Decimal(14, 2)
  donationCount       Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  donations           Donation[]

  @@index([email])
  @@index([phone])
  @@index([city, state])
}

model Donation {
  id                   String              @id @default(cuid())
  organizationId       String              @default("ORG_IMF_HQ")
  receiptNumber        String              @unique // Auto: IMF-REC-2026-XXXXX
  idempotencyKey       String              @unique
  
  donorId              String?
  donor                DonorProfile?       @relation(fields: [donorId], references: [id])
  campaignId           String?
  campaign             Campaign?           @relation(fields: [campaignId], references: [id])
  categoryId           String?
  category             DonationCategory?   @relation(fields: [categoryId], references: [id])
  
  // Snapshot Donor Details
  donorName            String
  donorEmail           String
  donorPhone           String?
  donorPanMasked       String?
  donorAddress         String?
  
  // Financial Amounts
  amount               Decimal             @db.Decimal(14, 2)
  currency             String              @default("INR")
  forexRateToINR       Decimal             @default(1.0) @db.Decimal(8, 4)
  amountInINR          Decimal             @db.Decimal(14, 2)
  
  fundType             FundType
  paymentMethod        PaymentMethod       @default(UPI)
  paymentProvider      PaymentProviderType @default(MOCK)
  paymentStatus        DonationStatus      @default(INITIATED)
  
  gatewayOrderId       String?
  gatewayPaymentId     String?             @unique
  gatewaySignature     String?
  
  isAnonymous          Boolean             @default(false)
  is80GRequested       Boolean             @default(false)
  is80GIssued          Boolean             @default(false)
  receiptPdfUrl        String?
  qrVerificationHash   String?             @unique // HMAC-SHA256 signature
  
  failedReason         String?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  taxExemptionReceipt  TaxExemptionReceipt?
  transactions         PaymentTransaction[]
  voucher              Voucher?
  refunds              RefundRecord[]

  @@index([receiptNumber])
  @@index([idempotencyKey])
  @@index([paymentStatus, createdAt])
  @@index([donorEmail])
  @@index([qrVerificationHash])
  @@index([gatewayOrderId])
}

model PaymentTransaction {
  id               String              @id @default(cuid())
  donationId       String
  donation         Donation            @relation(fields: [donationId], references: [id], onDelete: Cascade)
  provider         PaymentProviderType
  gatewayOrderId   String?
  gatewayPaymentId String?             @unique
  gatewaySignature String?
  amount           Decimal             @db.Decimal(14, 2)
  currency         String              @default("INR")
  status           DonationStatus      @default(PENDING)
  errorCode        String?
  errorMessage     String?
  rawPayload       Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([gatewayPaymentId])
  @@index([donationId])
  @@index([status])
}

model TaxExemptionReceipt {
  id                String    @id @default(cuid())
  certificateNumber String   @unique // Auto: IMF-80G-2026-XXXX
  donationId        String    @unique
  donation          Donation  @relation(fields: [donationId], references: [id])
  donorName         String
  donorPan          String
  donorAddress      String
  amount            Decimal   @db.Decimal(14, 2)
  financialYear     String    // e.g. "2026-2027"
  deductionPercent  Int       @default(50)
  issuedAt          DateTime  @default(now())
  pdfUrl            String?
  qrVerificationUrl String
  signatureHash     String    @unique // HMAC-SHA256 signature

  @@index([certificateNumber])
  @@index([financialYear])
  @@index([signatureHash])
}

model RefundRecord {
  id               String         @id @default(cuid())
  donationId       String
  donation         Donation       @relation(fields: [donationId], references: [id])
  amount           Decimal        @db.Decimal(14, 2)
  currency         String         @default("INR")
  reason           String
  gatewayRefundId  String?        @unique
  status           String         @default("PENDING") // PENDING, PROCESSED, FAILED
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([donationId])
  @@index([status])
}

// ============================================================================
// 6. FINANCIAL ACCOUNTING & GENERAL LEDGER
// ============================================================================

model AccountHead {
  id             String         @id @default(cuid())
  organizationId String         @default("ORG_IMF_HQ")
  accountCode    String         @unique // e.g. "1010-HDFC-BANK", "2010-ZAKAT-RESERVE"
  name           String
  accountType    AccountType
  parentHeadId   String?
  parentHead     AccountHead?   @relation("SubAccounts", fields: [parentHeadId], references: [id])
  subAccounts    AccountHead[]  @relation("SubAccounts")
  isRestricted   Boolean        @default(false)
  currentBalance Decimal        @default(0.0) @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  categories     DonationCategory[]
  voucherEntries VoucherEntry[]
  budgetLines    BudgetLine[]
  bankReconciliations BankReconciliationStatement[]

  @@index([accountCode])
  @@index([accountType])
}

model Voucher {
  id             String         @id @default(cuid())
  organizationId String         @default("ORG_IMF_HQ")
  voucherNumber  String         @unique // Auto: VCH-2026-XXXXX
  voucherType    VoucherType    @default(RECEIPT)
  voucherDate    DateTime       @default(now())
  narration      String         @db.Text
  totalAmount    Decimal        @db.Decimal(14, 2)
  donationId     String?        @unique
  donation       Donation?      @relation(fields: [donationId], references: [id])
  payrollPeriod  PayrollPeriod?
  isPosted       Boolean        @default(true)
  createdById    String         @default("SYSTEM_ENGINE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  entries        VoucherEntry[]
  grants         GrantAndCsrFunding[]
  expenses       ExpenseRecord[]
  reconciliationItems ReconciliationItem[]

  @@index([voucherNumber])
  @@index([voucherDate])
  @@index([voucherType])
}

model VoucherEntry {
  id            String      @id @default(cuid())
  voucherId     String
  voucher       Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountHeadId String
  accountHead   AccountHead @relation(fields: [accountHeadId], references: [id])
  debitAmount   Decimal     @default(0.0) @db.Decimal(14, 2)
  creditAmount  Decimal     @default(0.0) @db.Decimal(14, 2)
  particulars   String?

  @@index([voucherId])
  @@index([accountHeadId])
}

// ============================================================================
// 7. MEMBERSHIP & DIGITAL ID
// ============================================================================

model MemberProfile {
  id                 String             @id @default(cuid())
  organizationId     String             @default("ORG_IMF_HQ")
  membershipNumber   String             @unique // Auto: IMF-MEM-YYYY-XXXXX
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  fullName           String
  email              String             @unique
  phone              String
  gender             String?            // MALE, FEMALE, OTHER
  dateOfBirth        DateTime?
  avatarUrl          String?
  
  addressLine1       String?
  addressLine2       String?
  city               String
  state              String?
  postalCode         String?
  country            String             @default("India")
  
  membershipType     MembershipType     @default(ANNUAL)
  status             MembershipStatus   @default(PENDING)
  
  startDate          DateTime           @default(now())
  endDate            DateTime
  renewedAt          DateTime?
