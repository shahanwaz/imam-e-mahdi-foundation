  renewedBy        String         @default("SELF")
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([memberId])
  @@index([createdAt])
}

// ============================================================================
// 8. VOLUNTEER COORDINATION & ATTENDANCE
// ============================================================================

model VolunteerProfile {
  id                    String              @id @default(cuid())
  organizationId        String              @default("ORG_IMF_HQ")
  volunteerNumber       String              @unique // Auto: IMF-VOL-YYYY-XXXXX
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  fullName              String
  email                 String              @unique
  phone                 String
  city                  String
  state                 String?
  country               String              @default("India")
  avatarUrl             String?
  
  status                VolunteerStatus     @default(APPLIED)
  skills                String[]
  languages             String[]
  availability          String
  interests             String[]
  emergencyContactName  String?
  emergencyContactPhone String?
  
  totalHoursLogged      Decimal             @default(0.0) @db.Decimal(10, 2)
  totalAssignmentsCount Int                 @default(0)
  performanceRating     Decimal             @default(5.0) @db.Decimal(3, 2)
  
  digitalBadgeUrl       String?
  qrVerificationHash    String              @unique // HMAC-SHA256 signature
  
  verifiedByUserId      String?
  verifiedAt            DateTime?
  notes                 String?             @db.Text
